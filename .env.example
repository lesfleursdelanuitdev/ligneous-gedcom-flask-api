# Postgres connection (same DB as ligneous-frontend; this service has read-only on app tables, read/write on research schema)
DATABASE_URL=postgresql://user:password@localhost:5432/ligneous

# Optional: bind host and port for the Flask app
HOST=127.0.0.1
PORT=5001

# Groq LLM (natural-language search). Put the real key in `.env` only (gitignored).
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TIMEOUT_SECONDS=20

# NL search safety caps (optional)
# NL_MAX_ROWS=200
# NL_MAX_PROMPT_CHARS=1000

# When false, never write NL audit rows to research.* (alternative to proxy header X-Research-Persist).
# NL_PERSIST_QUERY_RUNS=true
